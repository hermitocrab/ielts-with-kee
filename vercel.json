{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/speaking-p2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/det-listening",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/det-listening", "destination": "/det-listening.html" }
  ]
}
