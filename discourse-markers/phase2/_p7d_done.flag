[{"id": "dm-1745d32870", "expression": "Having said that, there's still a small minority of people who", "variants": [], "collocation": {"en": "Position at the beginning of your response: Having said that, there's still a small minority of people who", "zh": ""}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "Having said that, there's still a small minority of people who This is not to say that the other option doesn't have its merits.", "zh": ""}, "cefr": "B2", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-a7ffa77359", "expression": "However, a significant drawback/downside is...\"", "variants": [], "collocation": {"en": "Use However, a significant drawback/downside is...\" to [situation-appropriate completion of the template]", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used when speculating or when your knowledge is incomplete", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows honest self-assessment", "zh": ""}, "example": {"en": "However, a significant drawback/downside is...\" For example, this is a great way to introduce your point naturally.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-03b3ac7387", "expression": "I have to acknowledge / admit ... , however", "variants": [], "collocation": {"en": "Use I have to acknowledge / admit ... , however to [situation-appropriate completion of the template]", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "I have to acknowledge / admit ... , however For example, this is a great way to introduce your point naturally.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-6217842d6f", "expression": "I might be wrong but I think", "variants": [], "collocation": {"en": "Use before or within a statement to indicate provisional judgment", "zh": ""}, "contexts": {"en": "Used when speculating or when your knowledge is incomplete", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows honest self-assessment", "zh": ""}, "example": {"en": "I might be wrong but I think This is a useful expression for expressing yourself naturally in English.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-8ad4f1deb7", "expression": "Mind you,", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a counterpoint", "zh": ""}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "Mind you This is not to say that the other option doesn't have its merits.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-7366938772", "expression": "Nevertheless,", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a counterpoint", "zh": ""}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "formal, academic, structured, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "The task was challenging. Nevertheless, we managed to complete it on time.", "zh": ""}, "cefr": "C1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-98b46e37ca", "expression": "Not really. / Yes, but ... / I wouldn't say so", "variants": [], "collocation": {"en": "Use Not really. / Yes, but ... / I wouldn't say so to [situation-appropriate completion of the template]", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to politely signal a different perspective in discussion-style tasks", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, polite disagreement strategies for discussion tasks", "zh": ""}, "example": {"en": "Not really. / Yes, but ... / I wouldn't say so For example, this is a great way to introduce your point naturally.", "zh": ""}, "cefr": "B2", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-862893a1d7", "expression": "That being said,", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a counterpoint", "zh": ""}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "The restaurant is expensive. That being said, the quality of food is outstanding.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-cfc29a46ee", "expression": "That being said, a small minority of people might think that", "variants": [], "collocation": {"en": "Position at the beginning of your response: That being said, a small minority of people might think that", "zh": ""}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "That being said, a small minority of people might think that This is not to say that the other option doesn't have its merits.", "zh": ""}, "cefr": "B2", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-8a50738cbc", "expression": "Though ..., I have to say that", "variants": [], "collocation": {"en": "Use Though ..., I have to say that to [situation-appropriate completion of the template]", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to introduce a different perspective or limitation to a previous statement", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": ""}, "example": {"en": "Though ..., I have to say that For example, this is a great way to introduce your point naturally.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-689f447714", "expression": "A great example of this is,", "variants": [], "collocation": {"en": "Use before citing a specific instance or illustration", "zh": ""}, "contexts": {"en": "Used to transition from a general claim to specific evidence", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": ""}, "example": {"en": "A great example of this is For instance, many young people today prefer to communicate online rather than in person.", "zh": ""}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-0ca8e01db2", "expression": "Another good example is that,", "variants": [], "collocation": {"en": "Use before citing a specific instance or illustration", "zh": ""}, "contexts": {"en": "Used to transition from a general claim to specific evidence", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": ""}, "example": {"en": "Another good example is that For instance, many young people today prefer to communicate online rather than in person.", "zh": ""}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-4d5d2ede8d", "expression": "Exhibit A, ...; Exhibit B, ...; Exhibit C,", "variants": [], "collocation": {"en": "Use Exhibit A, ...; Exhibit B, ...; Exhibit C, to [situation-appropriate completion of the template]", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to mark your answer as personal viewpoint, especially in Part 1 and Part 3", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, clearly marks personal stance", "zh": ""}, "example": {"en": "Exhibit A, ...; Exhibit B, ...; Exhibit C For example, this is a great way to introduce your point naturally.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-ce16f719c6", "expression": "ranging from ... to", "variants": [], "collocation": {"en": "Use ranging from ... to to [situation-appropriate completion of the template]", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to transition from a general claim to specific evidence", "zh": ""}, "c