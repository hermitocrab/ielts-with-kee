[{"id": "dm-1745d32870", "expression": "Having said that, there's still a small minority of people who", "variants": [], "collocation": {"en": "Position at the beginning of your response: Having said that, there's still a small minority of people who", "zh": "\u7f6e\u4e8e\u56de\u7b54\u5f00\u5934\uff1aHaving said that, there is still a small minority of people who + [\u89c2\u70b9]"}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": "\u9002\u7528\u4e8e\u5728\u9648\u8ff0\u5b8c\u4e3b\u8981\u89c2\u70b9\u540e\uff0c\u5f15\u5165\u4e00\u4e2a\u76f8\u53cd\u6216\u9650\u5236\u6027\u7684\u770b\u6cd5\uff0c\u5c55\u793a\u8bba\u8bc1\u7684\u5168\u9762\u6027"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "Having said that, there's still a small minority of people who This is not to say that the other option doesn't have its merits.", "zh": "Having said that, there is still a small minority of people who prefer traditional methods over modern technology."}, "cefr": "B2", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-a7ffa77359", "expression": "However, a significant drawback/downside is...\"", "variants": [], "collocation": {"en": "Use However, a significant drawback/downside is...\" to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aHowever, a significant drawback/downside is... + [\u5177\u4f53\u7f3a\u70b9\u63cf\u8ff0]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used when speculating or when your knowledge is incomplete", "zh": "\u7528\u4e8e\u5728\u8ba8\u8bba\u67d0\u4e8b\u7269\u4f18\u70b9\u540e\uff0c\u8f6c\u800c\u6307\u51fa\u5176\u4e3b\u8981\u7f3a\u70b9\u6216\u8d1f\u9762\u56e0\u7d20"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows honest self-assessment", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "However, a significant drawback/downside is...\" For example, this is a great way to introduce your point naturally.", "zh": "However, a significant drawback is that it can be quite expensive for the average family."}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-03b3ac7387", "expression": "I have to acknowledge / admit ... , however", "variants": [], "collocation": {"en": "Use I have to acknowledge / admit ... , however to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aI have to acknowledge/admit + [\u627f\u8ba4\u7684\u4e8b\u5b9e] + , however + [\u8f6c\u6298\u89c2\u70b9]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to introduce a different perspective or limitation to a previous statement", "zh": "\u7528\u4e8e\u5148\u627f\u8ba4\u5bf9\u65b9\u6216\u4e4b\u524d\u7684\u89c2\u70b9\u6709\u9053\u7406\uff0c\u518d\u63d0\u51fa\u4e0d\u540c\u770b\u6cd5\uff0c\u4f53\u73b0\u8fa9\u8bc1\u601d\u7ef4"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "I have to acknowledge / admit ... , however For example, this is a great way to introduce your point naturally.", "zh": "I have to admit the system is efficient, however, it lacks the personal touch that many people value."}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-6217842d6f", "expression": "I might be wrong but I think", "variants": [], "collocation": {"en": "Use before or within a statement to indicate provisional judgment", "zh": "\u7528\u4e8e\u9648\u8ff0\u524d\u8868\u660e\u6b64\u4e3a\u521d\u6b65\u5224\u65ad\uff1aI might be wrong but I think + [\u4e2a\u4eba\u89c2\u70b9]"}, "contexts": {"en": "Used when speculating or when your knowledge is incomplete", "zh": "\u5f53\u89c2\u70b9\u4e0d\u786e\u5b9a\u6216\u5e0c\u671b\u8868\u8fbe\u5f97\u8c26\u900a\u65f6\u4f7f\u7528\uff0c\u5c55\u73b0\u8bda\u5b9e\u548c\u81ea\u6211\u8bc4\u4f30\u80fd\u529b"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows honest self-assessment", "zh": "\u53e3\u8bed"}, "example": {"en": "I might be wrong but I think This is a useful expression for expressing yourself naturally in English.", "zh": "I might be wrong but I think the government should invest more in public transportation."}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-8ad4f1deb7", "expression": "Mind you,", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a counterpoint", "zh": "\u7f6e\u4e8e\u53e5\u9996\u5f15\u5165\u8865\u5145\u6216\u53cd\u9a73\uff1aMind you, + [\u76f8\u53cd\u6216\u8865\u5145\u89c2\u70b9]"}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": "\u7528\u4e8e\u5728\u53d1\u8868\u770b\u6cd5\u540e\uff0c\u8865\u5145\u4e00\u4e2a\u53cd\u5411\u6216\u9650\u5236\u6027\u7684\u89c2\u70b9\uff0c\u4f7f\u8bba\u8bc1\u66f4\u4e30\u5bcc"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": "\u53e3\u8bed"}, "example": {"en": "Mind you This is not to say that the other option doesn't have its merits.", "zh": "The restaurant is quite expensive. Mind you, the quality of the food is exceptional."}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-7366938772", "expression": "Nevertheless,", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a counterpoint", "zh": "\u7f6e\u4e8e\u53e5\u9996\u5f15\u51fa\u8f6c\u6298\uff1aNevertheless, + [\u76f8\u53cd\u89c2\u70b9\u6216\u7ed3\u8bba]"}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": "\u7528\u4e8e\u6b63\u5f0f\u8bed\u5883\u4e2d\uff0c\u5728\u627f\u8ba4\u67d0\u4e8b\u5b9e\u540e\u5f15\u51fa\u76f8\u53cd\u6216\u9650\u5236\u6027\u7ed3\u8bba"}, "connotation": {"en": "formal, academic, structured, adds depth to arguments by acknowledging alternatives", "zh": "\u6b63\u5f0f"}, "example": {"en": "The task was challenging. Nevertheless, we managed to complete it on time.", "zh": "The task was challenging. Nevertheless, we managed to complete it on time."}, "cefr": "C1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-98b46e37ca", "expression": "Not really. / Yes, but ... / I wouldn't say so", "variants": [], "collocation": {"en": "Use Not really. / Yes, but ... / I wouldn't say so to [situation-appropriate completion of the template]", "zh": "\u7528\u4e8e\u793c\u8c8c\u8868\u8fbe\u4e0d\u540c\u610f\u89c1\uff1aNot really / Yes, but... / I would not say so + [\u4f60\u7684\u89c2\u70b9]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to politely signal a different perspective in discussion-style tasks", "zh": "\u9002\u7528\u4e8e\u8ba8\u8bba\u7c7b\u9898\u76ee\uff0c\u793c\u8c8c\u5730\u8868\u8fbe\u4e0d\u540c\u89c2\u70b9\u800c\u4e0d\u663e\u5f97\u5bf9\u6297"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, polite disagreement strategies for discussion tasks", "zh": "\u53e3\u8bed"}, "example": {"en": "Not really. / Yes, but ... / I wouldn't say so For example, this is a great way to introduce your point naturally.", "zh": "Not really. I think the benefits of technology far outweigh the drawbacks."}, "cefr": "B2", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-862893a1d7", "expression": "That being said,", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a counterpoint", "zh": "\u7f6e\u4e8e\u53e5\u9996\u5f15\u51fa\u5bf9\u6bd4\uff1aThat being said, + [\u76f8\u53cd\u6216\u9650\u5236\u6027\u89c2\u70b9]"}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": "\u7528\u4e8e\u5148\u80af\u5b9a\u67d0\u4e00\u89c2\u70b9\u540e\uff0c\u793c\u8c8c\u5730\u5f15\u5165\u4e0d\u540c\u7684\u89c6\u89d2\u6216\u9650\u5236\u6761\u4ef6"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "The restaurant is expensive. That being said, the quality of food is outstanding.", "zh": "The restaurant is expensive. That being said, the quality of food is outstanding."}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-cfc29a46ee", "expression": "That being said, a small minority of people might think that", "variants": [], "collocation": {"en": "Position at the beginning of your response: That being said, a small minority of people might think that", "zh": "\u7f6e\u4e8e\u56de\u7b54\u5f00\u5934\uff1aThat being said, a small minority of people might think that + [\u5c11\u6570\u4eba\u89c2\u70b9]"}, "contexts": {"en": "Used to introduce a different perspective or limitation to a previous statement", "zh": "\u7528\u4e8e\u5728\u9610\u8ff0\u4e3b\u6d41\u89c2\u70b9\u540e\uff0c\u5f15\u5165\u5c11\u6570\u4eba\u7684\u4e0d\u540c\u770b\u6cd5\uff0c\u5c55\u793a\u5168\u9762\u601d\u8003\u80fd\u529b"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "That being said, a small minority of people might think that This is not to say that the other option doesn't have its merits.", "zh": "That being said, a small minority of people might think that online education is less effective than traditional classrooms."}, "cefr": "B2", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-8a50738cbc", "expression": "Though ..., I have to say that", "variants": [], "collocation": {"en": "Use Though ..., I have to say that to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aThough + [\u627f\u8ba4\u7684\u4e8b\u5b9e] + , I have to say that + [\u4f60\u7684\u89c2\u70b9]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to introduce a different perspective or limitation to a previous statement", "zh": "\u7528\u4e8e\u5148\u8ba9\u6b65\u518d\u8868\u8fbe\u4e3b\u8981\u89c2\u70b9\uff0c\u4f53\u73b0\u8fa9\u8bc1\u601d\u7ef4\u80fd\u529b"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, adds depth to arguments by acknowledging alternatives", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "Though ..., I have to say that For example, this is a great way to introduce your point naturally.", "zh": "Though it requires a lot of time, I have to say that learning a new language is incredibly rewarding."}, "cefr": "B1", "categoryIds": ["cat-013"], "subfunctionIds": [], "chainIds": [], "tags": ["contrast", "concession"], "seeAlso": []}, {"id": "dm-689f447714", "expression": "A great example of this is,", "variants": [], "collocation": {"en": "Use before citing a specific instance or illustration", "zh": "\u7528\u4e8e\u5f15\u51fa\u5177\u4f53\u4f8b\u8bc1\uff1aA great example of this is + [\u5177\u4f53\u4f8b\u5b50]"}, "contexts": {"en": "Used to transition from a general claim to specific evidence", "zh": "\u4ece\u6982\u62ec\u6027\u89c2\u70b9\u8fc7\u6e21\u5230\u5177\u4f53\u4e8b\u4f8b\u65f6\u4f7f\u7528\uff0c\u589e\u5f3a\u8bba\u8bc1\u8bf4\u670d\u529b"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "A great example of this is For instance, many young people today prefer to communicate online rather than in person.", "zh": "A great example of this is how many young people now prefer to communicate online rather than in person."}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-0ca8e01db2", "expression": "Another good example is that,", "variants": [], "collocation": {"en": "Use before citing a specific instance or illustration", "zh": "\u7528\u4e8e\u5f15\u51fa\u53e6\u4e00\u4e2a\u4f8b\u8bc1\uff1aAnother good example is that + [\u5177\u4f53\u4f8b\u5b50]"}, "contexts": {"en": "Used to transition from a general claim to specific evidence", "zh": "\u5728\u5df2\u7ed9\u51fa\u4e00\u4e2a\u4f8b\u5b50\u540e\uff0c\u7ee7\u7eed\u8865\u5145\u7b2c\u4e8c\u4e2a\u4f8b\u8bc1\u65f6\u4f7f\u7528"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "Another good example is that For instance, many young people today prefer to communicate online rather than in person.", "zh": "Another good example is that many companies are now offering remote work options to attract talent."}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-4d5d2ede8d", "expression": "Exhibit A, ...; Exhibit B, ...; Exhibit C,", "variants": [], "collocation": {"en": "Use Exhibit A, ...; Exhibit B, ...; Exhibit C, to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aExhibit A + [\u4f8b1]; Exhibit B + [\u4f8b2]; Exhibit C + [\u4f8b3]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to mark your answer as personal viewpoint, especially in Part 1 and Part 3", "zh": "\u7528\u4e8e\u4ee5\u5217\u4e3e\u5f62\u5f0f\u7ed9\u51fa\u591a\u4e2a\u4f8b\u8bc1\uff0c\u50cf\u6cd5\u5ead\u5448\u5802\u8bc1\u636e\u4e00\u6837\u6761\u7406\u6e05\u6670"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, clearly marks personal stance", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "Exhibit A, ...; Exhibit B, ...; Exhibit C For example, this is a great way to introduce your point naturally.", "zh": "Exhibit A, social media connects people globally; Exhibit B, it spreads information instantly."}, "cefr": "B1", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-ce16f719c6", "expression": "ranging from ... to", "variants": [], "collocation": {"en": "Use ranging from ... to to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aranging from + [\u6700\u5c0f\u9879] + to + [\u6700\u5927\u9879]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to transition from a general claim to specific evidence", "zh": "\u7528\u4e8e\u5217\u4e3e\u4e00\u4e2a\u8303\u56f4\u5185\u7684\u591a\u79cd\u4e8b\u7269\uff0c\u5c55\u793a\u8bcd\u6c47\u4e30\u5bcc\u5ea6"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "ranging from ... to For example, this is a great way to introduce your point naturally.", "zh": "The store sells a variety of products, ranging from fresh groceries to electronic devices."}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-6fc4db8789", "expression": "the most ... example is that,", "variants": [], "collocation": {"en": "Use the most ... example is that, to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1athe most + [\u5f62\u5bb9\u8bcd] + example is that + [\u5177\u4f53\u4f8b\u8bc1]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to transition from a general claim to specific evidence", "zh": "\u7528\u4e8e\u5728\u8bba\u8bc1\u4e2d\u7ed9\u51fa\u6700\u5177\u4ee3\u8868\u6027\u7684\u4f8b\u5b50\uff0c\u5f3a\u8c03\u5176\u5178\u578b\u6027"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "the most ... example is that For example, this is a great way to introduce your point naturally.", "zh": "The most striking example is that some countries have completely banned single-use plastics."}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-5f0e7a97c0", "expression": "To name a few,", "variants": [], "collocation": {"en": "Use before citing a specific instance or illustration", "zh": "\u7528\u4e8e\u5217\u4e3e\u6536\u5c3e\uff1aTo name a few, + [\u5217\u4e3e\u51e0\u4e2a\u4f8b\u5b50]"}, "contexts": {"en": "Used to transition from a general claim to specific evidence", "zh": "\u5728\u7ed9\u51fa\u591a\u4e2a\u4f8b\u8bc1\u540e\u7528\u4e8e\u6536\u5c3e\uff0c\u8868\u660e\u8fd9\u53ea\u662f\u5176\u4e2d\u4e00\u90e8\u5206\u4f8b\u5b50"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, strengthens arguments with concrete evidence", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "To name a few For instance, many young people today prefer to communicate online rather than in person.", "zh": "Many cities are becoming more eco-friendly. To name a few, Copenhagen, Vancouver, and Singapore."}, "cefr": "A2", "categoryIds": ["cat-014"], "subfunctionIds": [], "chainIds": [], "tags": ["exemplification"], "seeAlso": []}, {"id": "dm-433172ed06", "expression": "a great variety of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7f6e\u4e8e\u53e5\u9996\u6216\u53e5\u4e2d\uff1aa great variety of + [\u540d\u8bcd\u590d\u6570]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u6982\u62ec\u6027\u5730\u63cf\u8ff0\u6570\u91cf\u4f17\u591a\u3001\u79cd\u7c7b\u4e30\u5bcc\u7684\u73b0\u8c61\u6216\u4e8b\u7269"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "a great variety of This is a useful expression for expressing yourself naturally in English.", "zh": "There are a great variety of online courses available for students nowadays."}, "cefr": "B1", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-fd22601090", "expression": "a vast amount of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7f6e\u4e8e\u53e5\u9996\u6216\u53e5\u4e2d\uff1aa vast amount of + [\u4e0d\u53ef\u6570\u540d\u8bcd]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u5f3a\u8c03\u6570\u91cf\u6781\u5176\u5e9e\u5927\uff0c\u901a\u5e38\u4fee\u9970\u4e0d\u53ef\u6570\u540d\u8bcd"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "a vast amount of This is a useful expression for expressing yourself naturally in English.", "zh": "A vast amount of information is now accessible through the internet."}, "cefr": "B1", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-6cd703393b", "expression": "a wide range of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7f6e\u4e8e\u53e5\u9996\u6216\u53e5\u4e2d\uff1aa wide range of + [\u540d\u8bcd\u590d\u6570]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u63cf\u8ff0\u9009\u62e9\u6216\u79cd\u7c7b\u591a\u6837\uff0c\u5f3a\u8c03\u8986\u76d6\u9762\u5e7f"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "a wide range of This is a useful expression for expressing yourself naturally in English.", "zh": "Students can choose from a wide range of extracurricular activities at university."}, "cefr": "B1", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-9f6ba5ad60", "expression": "all kinds of dessert, especially", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7528\u4e8e\u6982\u62ec\u5217\u4e3e\uff1aall kinds of + [\u4e8b\u7269] + , especially + [\u7279\u522b\u5f3a\u8c03]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u6982\u62ec\u5e76\u5f3a\u8c03\u5176\u4e2d\u67d0\u4e00\u7c7b\u7279\u522b\u7a81\u51fa\u7684\u4e8b\u7269"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u53e3\u8bed"}, "example": {"en": "all kinds of dessert, especially This is a useful expression for expressing yourself naturally in English.", "zh": "I enjoy all kinds of dessert, especially those that are chocolate-based."}, "cefr": "B1", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-7b46615955", "expression": "In general, ... I'm pretty sure I'm not the only one who", "variants": [], "collocation": {"en": "Use In general, ... I'm pretty sure I'm not the only one who to [situation-appropriate completion of the template]", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aIn general, + [\u6982\u62ec\u89c2\u70b9] + I am pretty sure I am not the only one who + [\u4e2a\u4eba\u611f\u53d7]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to mark your answer as personal viewpoint, especially in Part 1 and Part 3", "zh": "\u7528\u4e8e\u5148\u505a\u6982\u62ec\u6027\u9648\u8ff0\uff0c\u518d\u4ee5\u5171\u60c5\u53e3\u543b\u8868\u8fbe\u4e2a\u4eba\u89c2\u70b9"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, clearly marks personal stance", "zh": "\u53e3\u8bed"}, "example": {"en": "In general, ... I'm pretty sure I'm not the only one who For example, this is a great way to introduce your point naturally.", "zh": "In general, I think people are becoming more health-conscious. I am pretty sure I am not the only one who tries to eat better these days."}, "cefr": "B2", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-be9ec5b394", "expression": "plenty of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7f6e\u4e8e\u53e5\u9996\u6216\u53e5\u4e2d\uff1aplenty of + [\u540d\u8bcd]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u8868\u793a\u6570\u91cf\u5145\u8db3\u3001\u7ef0\u7ef0\u6709\u4f59\uff0c\u6bd4a lot of\u66f4\u53e3\u8bed\u5316"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u53e3\u8bed"}, "example": {"en": "plenty of This is a useful expression for expressing yourself naturally in English.", "zh": "There are plenty of opportunities for young people to gain work experience."}, "cefr": "A2", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-7df519c54e", "expression": "There are lots of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aThere are lots of + [\u540d\u8bcd\u590d\u6570]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u6982\u62ec\u6027\u5730\u63cf\u8ff0\u6570\u91cf\u5f88\u591a\u7684\u4e8b\u7269\uff0c\u53e3\u8bed\u5316\u7a0b\u5ea6\u8f83\u9ad8"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u53e3\u8bed"}, "example": {"en": "There are lots of This is a useful expression for expressing yourself naturally in English.", "zh": "There are lots of reasons why people choose to live in big cities."}, "cefr": "B1", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-bb377df93d", "expression": "There are plenty of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to introduce a broad observation", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aThere are plenty of + [\u540d\u8bcd\u590d\u6570]"}, "contexts": {"en": "Used to make broader observations about trends or patterns", "zh": "\u7528\u4e8e\u5f3a\u8c03\u67d0\u4e8b\u7269\u6570\u91cf\u5145\u8db3\u3001\u4e0d\u532e\u4e4f"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, shows ability to identify patterns", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "There are plenty of This is a useful expression for expressing yourself naturally in English.", "zh": "There are plenty of ways to stay fit without going to the gym."}, "cefr": "B1", "categoryIds": ["cat-015"], "subfunctionIds": [], "chainIds": [], "tags": ["generalisation"], "seeAlso": []}, {"id": "dm-eb2e70d88b", "expression": "Apart from that, when it comes to", "variants": [], "collocation": {"en": "Use at the start of a new clause to introduce supplementary information", "zh": "\u7f6e\u4e8e\u65b0\u53e5\u5f00\u5934\uff1aApart from that, when it comes to + [\u65b0\u8bdd\u9898]"}, "contexts": {"en": "Used to extend a response with related supporting details", "zh": "\u7528\u4e8e\u5728\u4e00\u4e2a\u8bdd\u9898\u4e4b\u540e\u5f15\u5165\u76f8\u5173\u7684\u8865\u5145\u6027\u65b0\u8bdd\u9898"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, extends responses naturally", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "Apart from that, when it comes to This is a useful expression for expressing yourself naturally in English.", "zh": "Apart from that, when it comes to education, I believe practical skills are just as important as academic knowledge."}, "cefr": "A2", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-93770a7dc0", "expression": "As far as ... goes,", "variants": [], "collocation": {"en": "As far as [topic] goes, [personal opinion or observation]...", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aAs far as + [\u8bdd\u9898] + goes, + [\u89c2\u70b9\u6216\u89c2\u5bdf]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to narrow focus to a specific aspect of the question", "zh": "\u7528\u4e8e\u5c06\u8ba8\u8bba\u8303\u56f4\u9650\u5b9a\u5728\u67d0\u4e00\u7279\u5b9a\u65b9\u9762\uff0c\u5c55\u793a\u8bdd\u9898\u7ba1\u7406\u80fd\u529b"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "As far as ... goes For example, this is a great way to introduce your point naturally.", "zh": "As far as job satisfaction goes, I think work-life balance matters more than salary."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-6a9c2ca318", "expression": "As far as ... is concerned,", "variants": [], "collocation": {"en": "As far as [topic] is concerned, [statement]...", "zh": "\u4f7f\u7528\u6a21\u677f\uff1aAs far as + [\u8bdd\u9898] + is concerned, + [\u9648\u8ff0]"}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to narrow focus to a specific aspect of the question", "zh": "\u7528\u4e8e\u805a\u7126\u5230\u67d0\u4e00\u5177\u4f53\u8bdd\u9898\u8fdb\u884c\u8ba8\u8bba\uff0c\u6bd4As far as...goes\u66f4\u6b63\u5f0f"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": "\u6b63\u5f0f"}, "example": {"en": "As far as ... is concerned For example, this is a great way to introduce your point naturally.", "zh": "As far as environmental protection is concerned, individuals and governments share equal responsibility."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-04c2a32eae", "expression": "As for", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aAs for + [\u8bdd\u9898], + [\u9648\u8ff0]"}, "contexts": {"en": "Used to narrow focus to a specific aspect of the question", "zh": "\u7528\u4e8e\u8f6c\u6362\u8bdd\u9898\u6216\u805a\u7126\u5230\u67d0\u4e00\u7279\u5b9a\u65b9\u9762\uff0c\u81ea\u7136\u8854\u63a5"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "As for my future plans, I hope to pursue a master's degree abroad.", "zh": "As for my future plans, I hope to pursue a master degree abroad."}, "cefr": "A2", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-46ecd5d1ff", "expression": "As for me,", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aAs for me, + [\u4e2a\u4eba\u89c2\u70b9\u6216\u60c5\u51b5]"}, "contexts": {"en": "Used to narrow focus to a specific aspect of the question", "zh": "\u7528\u4e8e\u5728\u8ba8\u8bba\u666e\u904d\u60c5\u51b5\u540e\u56de\u5230\u81ea\u8eab\uff0c\u8868\u8fbe\u4e2a\u4eba\u89c2\u70b9"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "As for me This is a useful expression for expressing yourself naturally in English.", "zh": "As for me, I prefer studying in a quiet library rather than at home."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-05ae977a7d", "expression": "As for students, we might feel", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aAs for students, we might feel + [\u611f\u53d7\u6216\u89c2\u70b9]"}, "contexts": {"en": "Used to narrow focus to a specific aspect of the question", "zh": "\u7528\u4e8e\u4ece\u5b66\u751f\u7fa4\u4f53\u7684\u89c6\u89d2\u5207\u5165\uff0c\u8868\u8fbe\u5171\u9e23\u5f0f\u7684\u89c2\u70b9"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "As for students, we might feel This is a useful expression for expressing yourself naturally in English.", "zh": "As for students, we might feel pressured by the increasing competition in the job market."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-6795992e23", "expression": "As for the reason why,", "variants": [], "collocation": {"en": "Use within or at the start of a clause expressing causality", "zh": "\u7f6e\u4e8e\u53e5\u9996\u6216\u53e5\u4e2d\uff1aAs for the reason why, + [\u539f\u56e0\u89e3\u91ca]"}, "contexts": {"en": "Used to explain reasoning, especially in Part 3 analytical responses", "zh": "\u7528\u4e8ePart 3\u5206\u6790\u7c7b\u95ee\u9898\uff0c\u5f15\u5bfc\u51fa\u56e0\u679c\u903b\u8f91\u5206\u6790"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, demonstrates logical reasoning ability", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "As for the reason why This explains why the situation has changed so dramatically.", "zh": "As for the reason why, it has a lot to do with changing social values and economic pressures."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-2d4705cc1d", "expression": "As for the reason why, it's simply because", "variants": [], "collocation": {"en": "Use within or at the start of a clause expressing causality", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aAs for the reason why, it is simply because + [\u76f4\u63a5\u539f\u56e0]"}, "contexts": {"en": "Used to explain reasoning, especially in Part 3 analytical responses", "zh": "\u7528\u4e8e\u7ed9\u51fa\u76f4\u63a5\u3001\u7b80\u6d01\u7684\u539f\u56e0\uff0c\u7565\u5e26\u53e3\u8bed\u5316\u7684\u5f3a\u8c03"}, "connotation": {"en": "informal, conversational, natural, demonstrates logical reasoning ability", "zh": "\u53e3\u8bed"}, "example": {"en": "As for the reason why, it's simply because This explains why the situation has changed so dramatically.", "zh": "As for the reason why, it is simply because most people prefer convenience over cost."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-aef73ed66c", "expression": "As for the reason(s), I'd say", "variants": [], "collocation": {"en": "Use at the start of a clause to signal personal viewpoint", "zh": "\u7f6e\u4e8e\u53e5\u9996\uff1aAs for the reason(s), I would say + [\u4e2a\u4eba\u89c2\u70b9/\u539f\u56e0]"}, "contexts": {"en": "Used to mark your answer as personal viewpoint, especially in Part 1 and Part 3", "zh": "\u7528\u4e8e\u660e\u786e\u8868\u8fbe\u4e2a\u4eba\u5bf9\u539f\u56e0\u7684\u5206\u6790\uff0c\u7a81\u663e\u4e2a\u4eba\u7acb\u573a"}, "connotation": {"en": "semi-formal, appropriate for IELTS context, clearly marks personal stance", "zh": "\u534a\u6b63\u5f0f"}, "example": {"en": "As for the reason(s), I'd say technology has fundamentally changed the way we communicate with each other.", "zh": "As for the reasons, I would say technology has fundamentally changed the way we communicate with each other."}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-f3f8447c47", "expression": "First off, in terms of", "variants": [], "collocation": {"en": "Use at the beginning of a clause to order multiple points", "zh": ""}, "contexts": {"en": "Used to structure multi-point answers, especially in Part 2 long turns", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, improves coherence and cohesion scores", "zh": ""}, "example": {"en": "First off, in terms of I'll explain my reasons step by step.", "zh": ""}, "cefr": "A2", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-814b0dc0a8", "expression": "If we're talking about", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": ""}, "contexts": {"en": "Used to narrow focus to a specific aspect of the question", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": ""}, "example": {"en": "If we're talking about This is a useful expression for expressing yourself naturally in English.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-31b6c07a1f", "expression": "In terms of", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": ""}, "contexts": {"en": "Used to narrow focus to a specific aspect of the question", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": ""}, "example": {"en": "In terms of career development, I think internships are extremely valuable.", "zh": ""}, "cefr": "A2", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-79e2ee074a", "expression": "In terms of ...,", "variants": [], "collocation": {"en": "In terms of [category/field], [statement with specific reference]...", "zh": ""}, "contexts": {"en": "Template pattern: fill the placeholder with topic-relevant content. Used to Used to narrow focus to a specific aspect of the question", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": ""}, "example": {"en": "In terms of", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-428094e00d", "expression": "In terms of college students", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": ""}, "contexts": {"en": "Used to narrow focus to a specific aspect of the question", "zh": ""}, "connotation": {"en": "semi-formal, appropriate for IELTS context, signals topic management skills", "zh": ""}, "example": {"en": "In terms of college students This is a useful expression for expressing yourself naturally in English.", "zh": ""}, "cefr": "B1", "categoryIds": ["cat-016"], "subfunctionIds": [], "chainIds": [], "tags": ["topic-introduction"], "seeAlso": []}, {"id": "dm-c5ba4d4756", "expression": "Regarding / About", "variants": [], "collocation": {"en": "Use at the start of a sentence to focus attention on a specific aspect", "zh": ""}, "contexts": {"en": "Used to narrow